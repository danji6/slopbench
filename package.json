    "prune": "bun scripts/prune.ts",
    "convex": "bun x convex dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write",
    "barrels": "barrelsby -c ./barrels.json",
    "gen:icons": "node scripts/misc/generate-icons-data.mjs",
    "server": "bun scripts/sidecar.ts",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts"
