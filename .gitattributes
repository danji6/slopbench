# Normalize line endings for everyone, regardless of platform/core.autocrlf
* text=auto eol=lf

# Windows-only scripts must keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Kept out of release archives
CLAUDE.md export-ignore
PROJECT_ANALYSIS.md export-ignore
.github export-ignore
.vscode export-ignore
tests export-ignore

# Binary files
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
